# Supabase project URL.
# Find it in the Supabase Dashboard -> your project -> Project Settings -> API Keys.
# For local development use the URL printed by `supabase start`.
VITE_SUPABASE_URL=

# Supabase anon (public) key. Never put the service-role key here.
# Find it in the Supabase Dashboard -> your project -> Project Settings -> API Keys.
VITE_SUPABASE_ANON_KEY=

# Public site URL used for canonical links and Open Graph tags (no trailing slash).
# Leave empty to use the default https://mondelos-nature-park.vercel.app.
# Required for a production deploy (Vercel Production): the build stops without it.
VITE_SITE_URL=
